# Submission scope: only the assignment documents and runnable prototype.
/*
!/.gitignore
!/README.md
!/01-phong-van/
!/02-journey-map/
!/03-need-statement/
!/04-best-practice/
!/05-prototype/
!/06-rui-ro-dao-duc/
!/07-coach-plan/
!/slides.pdf

# Local secrets and generated caches
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
node_modules/
/05-prototype/playwright-report/
/05-prototype/test-results/
.DS_Store
Thumbs.db
*.log

# Downloaded speech models; keep source, licenses and download instructions.
/05-prototype/tts/models/**/*.onnx

# Download-session pages and helpers are not prototype evidence.
/05-prototype/references/*drive-folder.html
/05-prototype/references/mia/drive-folder.html
/05-prototype/references/mia/download.py
/05-prototype/references/additional/download.config

# Local brainstorming notes
/brainstorm/

# Private interview audio and transcription workspace
/.local-transcription/

# Development evidence and experiments stay on this machine.
/05-prototype/artifacts/
/05-prototype/references/
/05-prototype/scripts/
/05-prototype/tests/
/05-prototype/playwright.config.mjs
/05-prototype/verification.md
/05-prototype/mock-data/

# Keep only the code and setup needed by the current local voice.
/05-prototype/tts/*
!/05-prototype/tts/README.md
!/05-prototype/tts/worker.py
!/05-prototype/tts/vieneu_voice.py
!/05-prototype/tts/download_vieneu.py
!/05-prototype/tts/requirements-lock.txt
!/05-prototype/tts/vieneu-sources.json

# Current Kokoro runtime and installation scripts.
!/05-prototype/tts/kokoro_voice.py
!/05-prototype/tts/setup-kokoro.ps1
!/05-prototype/tts/download-kokoro.ps1

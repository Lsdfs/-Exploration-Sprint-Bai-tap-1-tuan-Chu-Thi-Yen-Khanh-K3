# Only enable OpenAI explicitly. The default runs locally with scripted guidance.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
PORT=4173
HOST=127.0.0.1
# Optional: override the Python executable for the offline TTS worker.
# Default: .tts-venv/Scripts/python.exe on Windows; .tts-venv/bin/python elsewhere.
# TTS_PYTHON=

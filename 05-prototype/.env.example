# Gemini settings mirror the Gemini branch of double fun; keys stay server-side.
AI_PROVIDER=gemini
VOICE_PROVIDER=gemini-live
# Set false and restart to return to recorded Gemini transcription.
LIVE_TRANSCRIPT_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_THINKING_LEVEL=medium
# Optional historical OpenAI configuration; Gemini live uses GEMINI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
PORT=4173
HOST=127.0.0.1
# Optional: override the Python executable for the offline TTS worker.
# Default: .tts-venv/Scripts/python.exe on Windows; .tts-venv/bin/python elsewhere.
# TTS_PYTHON=
